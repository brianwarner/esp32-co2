# Wi-Fi credentials. 2.4 GHz only; the ESP32-S3 has no 5 GHz radio.
WIFI_SSID=
WIFI_PASSWORD=

# Optional backup networks, tried in order whenever the current one drops or
# is out of range. Fill in order (WIFI_SSID_2 before WIFI_SSID_3).
WIFI_SSID_2=
WIFI_PASSWORD_2=
WIFI_SSID_3=
WIFI_PASSWORD_3=

# IANA timezone name (resolved against the build machine's zoneinfo database),
# or a literal POSIX TZ string such as EST5EDT,M3.2.0,M11.1.0
TIMEZONE=America/New_York

# 12 or 24
HOURS=12

# C or F, for the temperature reading from the CO2 sensor's onboard SHT40
TEMP_UNIT=F

# How often to read the CO2 sensor, in seconds. The display still only
# repaints once a minute, but a shorter interval catches brief CO2 spikes
# that a once-a-minute read could land between. Defaults to 15.
SAMPLE_INTERVAL_SECONDS=15

NTP_SERVER=pool.ntp.org

# How often to do a full refresh, in whole hours (clears the ghosting that
# partial refreshes accumulate). Defaults to 1.
REFRESH_INTERVAL_HOURS=1

# Optional 24-hour HH:MM. Anchors full refreshes to this time of day instead
# of to whenever the board happened to boot, e.g. REFRESH_INTERVAL_HOURS=6
# with REFRESH_TIME=00:00 refreshes at 00:00, 06:00, 12:00, 18:00 every day.
# Leave blank to refresh every REFRESH_INTERVAL_HOURS from boot, as before.
REFRESH_TIME=

# CO2 ppm thresholds (must satisfy ELEVATED < ALERT < WARNING) that drive the
# onboard RGB LED, based on the average CO2 reading over the past 2 minutes:
# below ELEVATED the LED is green, ELEVATED-ALERT it's yellow, ALERT-WARNING
# it's solid red, above WARNING it flashes red. The LED is blue at startup
# (before any reading) and flashes purple if the sensor isn't detected.
ELEVATED=1000
ALERT=2000
WARNING=5000
